# ForgeOS environment — copy to .env.local and fill in. All are OPTIONAL:
# with none set, the app runs fully on the local mock data layer.

# --- Supabase (Postgres + Auth + Realtime + Storage) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI vision macro scanner (any image->macros endpoint) ---
VITE_VISION_API_URL=
VITE_VISION_API_KEY=

# --- Spotify (register a Developer App, set redirect URI to <origin>/spotify-callback) ---
VITE_SPOTIFY_CLIENT_ID=
